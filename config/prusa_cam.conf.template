# Prusa Connect Camera Configuration
# Generated by install.sh on __DATE__
#
# Edit this file to change camera settings
# After editing, restart services:
#   sudo systemctl restart prusa-connect-upload
#   sudo systemctl restart camera-stream

# ============================================
# Camera Settings
# ============================================

# Camera type: RPI or USB
CAMERA_TYPE="__CAMERA_TYPE__"

# For RPi cameras: camera index (0, 1, etc.)
CAMERA_ID="__CAMERA_ID__"

# For USB cameras: device path (e.g., /dev/video0)
CAMERA_DEVICE="__CAMERA_DEVICE__"

# Camera name (for display purposes)
CAMERA_NAME="__CAMERA_NAME__"

# ============================================
# Prusa Connect API Settings
# ============================================

# Your unique camera fingerprint (UUID)
FINGERPRINT="__FINGERPRINT__"

# Camera token from Prusa Connect
# Get this from: connect.prusa3d.com -> Your Printer -> Camera -> Add Camera
TOKEN="__TOKEN__"

# ============================================
# Capture Settings (for Prusa Connect uploads)
# ============================================

# Capture resolution (width x height)
CAPTURE_WIDTH=1920
CAPTURE_HEIGHT=1080

# Upload interval in seconds
UPLOAD_INTERVAL=10

# ============================================
# Stream Settings (for local web viewer)
# ============================================

# Stream server port
STREAM_PORT=8080

# Stream resolution (lower than capture for performance)
STREAM_WIDTH=1280
STREAM_HEIGHT=720

# ============================================
# Secondary Camera Settings (optional)
# ============================================

# Enable secondary camera: 0 or 1
SECOND_CAMERA_ENABLED=0

# Secondary camera type: RPI or USB
SECOND_CAMERA_TYPE=""

# For secondary RPi cameras: camera index (0, 1, etc.)
SECOND_CAMERA_ID=""

# For secondary USB cameras: device path (e.g., /dev/video1)
SECOND_CAMERA_DEVICE=""

# Secondary camera name (for display purposes)
SECOND_CAMERA_NAME=""

# Secondary camera fingerprint and token from Prusa Connect
SECOND_FINGERPRINT=""
SECOND_TOKEN=""

# Secondary focus settings
SECOND_FOCUS_MODE="auto"
SECOND_FOCUS_VALUE=0
SECOND_FOCUS_SETTLE_TIME=2

# Secondary MJPEG stream settings; use a different port than STREAM_PORT
SECOND_STREAM_PORT=8081
SECOND_STREAM_WIDTH=1280
SECOND_STREAM_HEIGHT=720
